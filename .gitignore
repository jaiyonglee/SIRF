# Python cache / compiled
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
env/
venv/
*.env

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs.txt

# Results & experiment outputs (reproducible)
results/*
!results/**/README.md
!results/reconstructed

# Data: ignore all except demo
data/*
!data/demo
!data/**/README.md

# Configs: ignore all except demo
configs/*
!configs/default.yaml

# Config artifacts (temp)
*.yaml~
*.yml~

# IDE / editor settings
.vscode/
.idea/
